NODE_ENV=development

# PostgreSQL. Local:  postgres://localhost:5432/resolve_ai
# Neon: copy the pooled connection string from console.neon.tech (ends in ?sslmode=require)
DATABASE_URL=postgres://localhost:5432/resolve_ai

# PayPal SANDBOX app: developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App (Merchant)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# After `pnpm paypal:webhook https://your-site` (needs a public HTTPS URL), paste its Webhook ID
PAYPAL_WEBHOOK_ID=

# Any OpenAI-compatible chat completions API, e.g. Groq:
#   AI_API_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=openai/gpt-oss-120b
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
# live = real model calls; demo = the clearly labelled deterministic negotiator (no AI key needed)
AI_MODE=live

# 32+ random characters: openssl rand -hex 32
SESSION_SECRET=

FRONTEND_URL=http://localhost:5180
BACKEND_PORT=5001

# Production only: a shared code in front of the demo (16+ characters): openssl rand -hex 16
DEMO_ACCESS_CODE=
# Optional: overrides the per-minute limits on sign-in, payment and AI routes
# RATE_LIMIT_MAX=

# Optional AI models: investigator and reviewer (default AI_MODEL), used when the main model's free
# allowance runs out, and the injection classifier
# AI_MODEL_ANALYST=
# AI_MODEL_FALLBACK=openai/gpt-oss-20b
# AI_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
